# FrostByte — pacman install/upgrade/remove scriptlets.

_drvname=acer-wmi-linuwu
_drvver=7.3.0.1

post_install() {
  if [ -d "/usr/src/${_drvname}-${_drvver}" ]; then
    dkms add    "${_drvname}/${_drvver}" >/dev/null 2>&1 || :
    dkms build  "${_drvname}/${_drvver}" >/dev/null 2>&1 || :
    dkms install "${_drvname}/${_drvver}" >/dev/null 2>&1 || :
  fi
  modprobe -r acer_wmi 2>/dev/null || :
  modprobe acer_wmi 2>/dev/null || :
  if [ ! -e /etc/frostbyte/frostbyte.conf ]; then
    mkdir -p /etc/frostbyte
    cp /usr/share/frostbyte/frostbyte.conf /etc/frostbyte/frostbyte.conf || :
  fi
  systemctl daemon-reload || :
  systemctl enable --now frostbyte-daemon.service frostbyte-keyd.service 2>/dev/null || :
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl disable --now frostbyte-daemon.service frostbyte-keyd.service 2>/dev/null || :
}

post_remove() {
  systemctl daemon-reload || :
  rm -f /run/frostbyte.sock
  if command -v dkms >/dev/null 2>&1; then
    dkms remove "${_drvname}/${_drvver}" --all >/dev/null 2>&1 || :
  fi
  modprobe -r acer_wmi 2>/dev/null || :
  depmod -a 2>/dev/null || :
}
