[Unit]
Description=FrostByte - NitroSense/PredatorSense key handler
Documentation=https://github.com/frostbyte-laptop/frostbyte
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/frostbyte/frostbyte-keyd.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
