"""Run an app on the NVIDIA dGPU via PRIME render offload.

Usage: frostbyte-gpu-run <command> [args ...]
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import frostbyte_gpu as gpu


def main():
    if len(sys.argv) < 2:
        print("usage: frostbyte-gpu-run <command> [args ...]", file=sys.stderr)
        sys.exit(2)
    try:
        gpu.launch_on_gpu(sys.argv[1:])
    except OSError as exc:
        print(f"frostbyte-gpu-run: {exc}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
